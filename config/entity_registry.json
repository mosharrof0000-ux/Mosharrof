{
  "schema_version": "1.2.0",
  "entities": [
    {
      "id": "core",
      "name": "Mosharrof Core",
      "responsibility": "coordination and governance",
      "brain": "core-brain",
      "scope": "core/*",
      "permissions": ["read", "write", "execute"],
      "delete_allowed": false
    },
    {
      "id": "chat",
      "name": "Chat Box",
      "responsibility": "conversation interface and request routing",
      "brain": "chat-brain",
      "scope": "chat/*",
      "permissions": ["read", "message"],
      "delete_allowed": false
    },
    {
      "id": "sidebar",
      "name": "Sidebar",
      "responsibility": "navigation and entity discovery",
      "brain": "sidebar-brain",
      "scope": "sidebar/*",
      "permissions": ["read", "render"],
      "delete_allowed": false
    },
    {
      "id": "ui",
      "name": "UI System",
      "responsibility": "presentation and adaptive layout",
      "brain": "ui-brain",
      "scope": "ui/*",
      "permissions": ["read", "render"],
      "delete_allowed": false
    },
    {
      "id": "voice",
      "name": "Voice Engine",
      "responsibility": "voice input and social-memory processing",
      "brain": "voice-brain",
      "scope": "voice/*",
      "permissions": ["read", "process"],
      "delete_allowed": false
    },
    {
      "id": "storage",
      "name": "Storage Engine",
      "responsibility": "file indexing and explicitly authorized organization",
      "brain": "storage-brain",
      "scope": "storage/*",
      "permissions": ["read", "organize"],
      "delete_allowed": false
    },
    {
      "id": "tool_factory",
      "name": "Tool Factory",
      "responsibility": "safe tool creation, registration and execution",
      "brain": "tool-brain",
      "scope": "tool_factory/*",
      "permissions": ["read", "create_tool", "execute_tool"],
      "delete_allowed": false
    },
    {
      "id": "quran_research",
      "name": "Al-Quran Research",
      "responsibility": "Quran language research and evidence-based research workflows",
      "brain": "external-project://al-quran-research",
      "scope": "quran_research/*",
      "permissions": ["read", "research"],
      "delete_allowed": false,
      "integration_state": "independent-until-explicit-integration"
    }
  ]
}
