{
  "schema_version": "1.0.0",
  "status": "partial",
  "policy": {
    "approval_mode": "every_action",
    "least_privilege": true,
    "check_permission_at_point_of_use": true,
    "verify_result": true,
    "report_unverified_as_success": false,
    "deny_scope_escape": true,
    "delete_allowed": false,
    "destructive_operations_allowed": false,
    "broad_access_by_default": false,
    "temporary_access_must_expire": true,
    "secrets_in_client_or_logs": false
  },
  "risk_classes": [
    "read_private_data",
    "local_change",
    "external_effect",
    "restricted"
  ],
  "capability_statuses": [
    "planned",
    "partial",
    "existing_ci_built",
    "blocked_by_platform_provider",
    "verified"
  ],
