{
  "autonomous": {
    "enabled": true,
    "cadence_hours": 6,
    "max_changed_files": 12,
    "allowed_paths": ["web/","src/","backend/","tests/","config/","docs/"],
    "denied_paths": [".github/workflows/","CODEOWNERS"],
    "require_tests": true,
    "require_pull_request": true,
