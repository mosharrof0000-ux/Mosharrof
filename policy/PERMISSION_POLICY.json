    {"id": "ENTITY_SCOPE", "effect": "DENY", "condition": "requested_scope_outside_entity_scope"},
    {"id": "AUDIT_REQUIRED", "effect": "REQUIRE", "condition": "write_or_permission_change"},
    {"id": "TEMPORARY_PERMISSION", "effect": "ALLOW_WITH_AUDIT", "condition": "task_bound_and_expiring"}
  ]
