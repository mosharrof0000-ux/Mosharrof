{
  "schema_version": "1.0",
  "profiles": {
    "core.minimum": {
      "allow": ["read", "create", "update", "execute", "communicate", "audit"],
      "deny": ["delete", "destructive"],
      "scope": "registered Mosharrof project resources"
    },
    "entity.minimum": {
      "allow": ["read", "create", "update", "execute", "communicate", "audit"],
      "deny": ["delete", "destructive"],
      "scope": "entity-owned resources only"
    }
  },
  "temporary_permission_rule": {
    "enabled": true,
    "requires": ["specific_task", "audit_record", "time_or_task_boundary", "automatic_revoke"],
    "permanent_denial": ["delete", "destructive"]
  }
}
