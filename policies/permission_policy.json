{
  "schema_version": "1.0.0",
  "global_rules": {
    "delete": "DENY_ALWAYS",
    "destructive_operations": "DENY_ALWAYS",
    "secret_values": "NEVER_STORE_IN_SOURCE",
    "least_privilege_for_child_entities": true,
    "temporary_permission": {
      "allowed": true,
      "must_be_scoped": true,
      "must_be_audited": true,
      "must_expire": true
    }
  },
  "capability_formula": "brain x permission x policy x scope x identity"
}
